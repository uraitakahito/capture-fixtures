{
  "name": "capture-fixtures",
  "version": "0.1.0",
  "description": "Shared Fastify fixture-origin — the synthetic internet that Chrome visits in BrowserHive and capture-ledger integration tests.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "site"
  ],
  "scripts": {
    "generate:version": "node scripts/generate-version.mjs",
    "prebuild": "pnpm run generate:version",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm run generate:version",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run generate:version",
    "test": "vitest run",
    "test:watch": "vitest",
    "prelint": "pnpm run generate:version",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "start": "node dist/serve.js",
    "site:dev": "npm --prefix docs-site run dev",
    "site:build": "npm --prefix docs-site run build",
    "site:preview": "npm --prefix docs-site run preview",
    "site:check": "pnpm run site:build && node scripts/check-doc-refs.mjs",
    "audit": "pnpm audit --audit-level=low && npm audit --prefix docs-site --audit-level=low",
    "check": "pnpm run audit && pnpm run typecheck && pnpm run lint && pnpm test"
  },
  "keywords": [
    "fastify",
    "fixture",
    "test",
    "browserhive",
    "capture-ledger"
  ],
  "author": "Takahito Urai",
  "license": "The Unlicense",
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "//packageManager": "Read by pnpm/action-setup in CI and by corepack in the Dockerfile, so the version is written down once here rather than repeated in each. Same pin as the sibling repositories. See pnpm-workspace.yaml for the two places pnpm departs from npm silently (allowBuilds, enablePrePostScripts).",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
